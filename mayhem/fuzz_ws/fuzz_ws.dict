# Packet signature, commands and framing of WebUI's binary WebSocket protocol.
sign="\xDD"
cmd_js="\xFE"
cmd_click="\xFC"
cmd_navigation="\xFB"
cmd_call_func="\xF9"
cmd_multi="\xF6"
cmd_check_tk="\xF5"
cmd_win_drag="\xF4"
cmd_win_resized="\xF3"
fn_echo="mayhem_echo\x00"
fn_unbound="no_such_fn\x00"
sep=";"
nul="\x00"
len_pair="5;3\x00"
